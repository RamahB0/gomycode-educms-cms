# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=educms
PGUSER=educms
PGPASSWORD=change_me

# Redis (optional caching layer - the app degrades gracefully if unset/unreachable)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=2h

# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# Uploads
UPLOAD_DIR=uploads
